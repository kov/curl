<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
parallel
--retry
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
HTTP/1.1 503 BAD swsbounce
Content-Length: 21

server not available
</data>
<data1 nocheck="yes">
HTTP/1.1 200 OK
Content-Length: 3

ok
</data1>
</reply>

# Client-side
<client>
<server>
http
</server>
<name>
--parallel tries a transfer again, added again after its wait
</name>
<command option="no-output no-include">
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -Z --retry 1 --retry-delay 1 -s -o %LOGDIR/out%TESTNUMBER -w "%{num_retries} %{exitcode}\n"
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout>
1 0
</stdout>
<file name="%LOGDIR/out%TESTNUMBER">
ok
</file>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

</protocol>
</verify>
</testcase>

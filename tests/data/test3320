<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP PUT
--crlf
chunked Transfer-Encoding
</keywords>
</info>
# Server-side
<reply>
<data>
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Content-Length: 3

ok
</data>
</reply>

# Client-side
<client>
<server>
http
</server>
<name>
HTTP PUT from file with --crlf
</name>
# the line ends converted, the body's size is no longer known: it goes chunked
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER -T %LOGDIR/test%TESTNUMBER.txt --crlf
</command>
<file name="%LOGDIR/test%TESTNUMBER.txt">
one
two
three
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="yes">
PUT /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*
Transfer-Encoding: chunked

11
one
two
three

0

</protocol>
</verify>
</testcase>

<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
MQTT
HTTP
followlocation
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
hello
</data>
<data2>
HTTP/1.1 302 Moved
Location: mqtt://%HOSTIP:%MQTTPORT/%TESTNUMBER
Content-Length: 0
Connection: close

</data2>
</reply>

# Client-side
<client>
<features>
mqtt
</features>
<server>
http
mqtt
</server>
<name>
MQTT redirect to another host without the application's login
</name>
<command option="binary-trace">
-L --proto-redir mqtt -u user:secret http://%HOSTIP:%HTTPPORT/%TESTNUMBER0002
</command>
</client>

# Verify data after the test has been "shot"
<verify>
# HTTP's own request is not what is checked. The CONNECT's length and its
# flags are: they would say a user and a password.
<strip>
^GET
^Host:
^Authorization:
^User-Agent:
^Accept:
^\r?$
</strip>
<strippart>
s/^(client CONNECT \w+ 00044d5154540402).*/$1/
s/^(client SUBSCRIBE).*/$1/
</strippart>
<protocol>
client CONNECT 18 00044d5154540402
server CONNACK 2 20020000
client SUBSCRIBE
server SUBACK 3 9003000100
server PUBLISH c 300c00043337303268656c6c6f0a
server DISCONNECT 0 e000
</protocol>
</verify>
</testcase>

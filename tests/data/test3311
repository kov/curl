<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
SOCKS5
</keywords>
</info>
# Server-side
<reply>
# method 2 is SOCKS5 asking for user+password, which --socks5-gssapi
# alone does not allow
<servercmd>
method 2
nmethods_min 1
nmethods_max 2
user uz3r
password p4ssworm
</servercmd>
</reply>

# Client-side
<client>
<server>
socks5
</server>
<features>
http
proxy
</features>
<name>
SOCKS5 proxy asking for user+password with --socks5-gssapi alone
</name>

# it should never connect to the target server
<command>
http://localhost:99/%TESTNUMBER -x socks5://uz3r:p4ssworm@%HOSTIP:%SOCKSPORT --socks5-gssapi -sS
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
97
</errorcode>
<stderr mode="text">
curl: (97) BASIC authentication proposed but not enabled.
</stderr>
</verify>
</testcase>

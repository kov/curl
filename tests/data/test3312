<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
connect to non-listen
progress
</keywords>
</info>
# Server-side
<reply>
</reply>

# Client-side
<client>
<features>
http
</features>
<name>
no progress meter for a connect refused
</name>

# the meter is on: it shows only once the transfer has connected
<command>
http://%HOSTIP:%NOLISTENPORT/%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
7
</errorcode>
<file name="%LOGDIR/stderr%TESTNUMBER" mode="text">
curl: (7) Failed to connect to %HOSTIP:%NOLISTENPORT after X ms: Could not connect to server
</file>
<stripfile>
s/after \d+ ms/after X ms/
</stripfile>
</verify>
</testcase>

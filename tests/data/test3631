<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SFTP
SFTP put
Resume
</keywords>
</info>

# Server-side
<reply>
</reply>

# Client-side
<client>
<server>
sftp
</server>
<features>
libssh
</features>
<name>
SFTP upload resumed past the end of the file
</name>
<command>
--key %LOGDIR/server/curl_client_key --pubkey %LOGDIR/server/curl_client_key.pub -u %USER: -T %LOGDIR/file%TESTNUMBER.txt -C 30 sftp://%HOSTIP:%SSHPORT%SFTP_PWD/%LOGDIR/upload.%TESTNUMBER --insecure
</command>
<file name="%LOGDIR/file%TESTNUMBER.txt">
0123456789
</file>
<file2 name="%LOGDIR/upload.%TESTNUMBER">
stored
</file2>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
43
</errorcode>
<file name="%LOGDIR/upload.%TESTNUMBER">
stored
</file>
</verify>
</testcase>

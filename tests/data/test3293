<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
--proto
--proto-redir
--libcurl
</keywords>
</info>

# Server-side
<reply>
<data>
HTTP/1.1 200 OK
Content-Length: 6

hello
</data>
</reply>

# Client-side
<client>
<server>
http
</server>
<features>
http
file
--libcurl
</features>
<name>
--libcurl writes the --proto and --proto-redir sets by name, sorted
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --libcurl %LOGDIR/test%TESTNUMBER.c --proto =HTTP,FILE --proto-redir =file,-http,+FILE
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

</protocol>
<stripfile>
$_ = '' if !/PROTOCOLS/
</stripfile>
<file name="%LOGDIR/test%TESTNUMBER.c" mode="text">
  curl_easy_setopt(curl, CURLOPT_PROTOCOLS_STR, "file,http");
  curl_easy_setopt(curl, CURLOPT_REDIR_PROTOCOLS_STR, "file");
</file>
</verify>
</testcase>

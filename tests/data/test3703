<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP CONNECT
HTTP proxy
proxytunnel
FTP
followlocation
</keywords>
</info>

# Server-side
<reply>
<connect>
HTTP/1.1 200 Mighty fine indeed

</connect>
<data2>
HTTP/1.1 302 Moved swsclose
Location: ftp://second.%TESTNUMBER:%FTPPORT/%TESTNUMBER
Connection: close
Content-Length: 0

</data2>
<data>
silly content
</data>
<datacheck>
HTTP/1.1 200 Mighty fine indeed

HTTP/1.1 302 Moved swsclose
Location: ftp://second.%TESTNUMBER:%FTPPORT/%TESTNUMBER
Connection: close
Content-Length: 0

silly content
</datacheck>
</reply>

# Client-side
<client>
<server>
http
http-proxy
ftp
</server>
<features>
proxy
</features>
<name>
proxy tunnels after a redirect to FTP send no Authorization or Cookie
</name>
<command>
http://first.%TESTNUMBER:%HTTPPORT/%TESTNUMBER0002 -L -p -x %HOSTIP:%PROXYPORT --proxy-header "Authorization: Bearer secret" --proxy-header "Cookie: crumb=1"
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<strippart>
s/^((CONNECT |Host: )second\.\d+:)\d+/${1}PORT/
</strippart>
<proxy crlf="headers">
CONNECT first.%TESTNUMBER:%HTTPPORT HTTP/1.1
Host: first.%TESTNUMBER:%HTTPPORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive
Authorization: Bearer secret
Cookie: crumb=1

CONNECT second.%TESTNUMBER:PORT HTTP/1.1
Host: second.%TESTNUMBER:PORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive

CONNECT second.%TESTNUMBER:PORT HTTP/1.1
Host: second.%TESTNUMBER:PORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive

</proxy>
</verify>
</testcase>

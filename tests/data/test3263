<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
httpsig
RFC9421
</keywords>
</info>

# Server-side
<reply>
<data crlf="headers" nocheck="yes">
HTTP/1.1 301 OK
Content-Length: 0
Location: http://example.org:9000/%TESTNUMBER0002?b=2

</data>
<data2 crlf="headers" nocheck="yes">
HTTP/1.1 200 OK
Content-Length: 6
Connection: close
Content-Type: text/html

-foo-
</data2>
</reply>

# Client-side
<client>
<server>
http
</server>
<features>
Debug
httpsig
</features>
<name>
httpsig: HMAC-SHA256 not sent to a redirect's other origin
</name>
<command>
"http://example.com:8000/%TESTNUMBER/resource?a=1" --httpsig-algo hmac-sha256 --httpsig-key @%SRCDIR/data/data-httpsig-hmac-sha256.key --httpsig-keyid "shared-key-1" --connect-to example.com:8000:%HOSTIP:%HTTPPORT --connect-to example.org:9000:%HOSTIP:%HTTPPORT --location
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET /%TESTNUMBER/resource?a=1 HTTP/1.1
Host: example.com:8000
Signature-Input: sig1=("@method" "@authority" "@path" "@query");created=0;keyid="shared-key-1";alg="hmac-sha256"
Signature: sig1=:S7uxzCBuW1HCzZyF9kKiJtNFLG2BrtrJNDRJn5QMgAk=:
User-Agent: curl/%VERSION
Accept: */*

GET /%TESTNUMBER0002?b=2 HTTP/1.1
Host: example.org:9000
User-Agent: curl/%VERSION
Accept: */*

</protocol>
</verify>
</testcase>

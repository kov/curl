<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
FILE
parallel
--fail-early
</keywords>
</info>

# Server-side
<reply>
<servercmd>
writedelay: 1000
</servercmd>
<data nocheck="yes">
HTTP/1.1 200 OK
Content-Length: 1201


</data>
</reply>

# Client-side
<client>
<server>
http
</server>
<name>
--parallel --fail-early stops the transfers running once one fails
</name>
<command option="no-output no-include">
file://%FILE_PWD/%LOGDIR/nosuch%TESTNUMBER http://%HOSTIP:%HTTPPORT/%TESTNUMBER -Z --fail-early -sS -o %LOGDIR/out1-%TESTNUMBER -o %LOGDIR/out2-%TESTNUMBER -w "%{urlnum} %{exitcode}\n"
</command>
</client>

# Verify data after the test has been "shot"
# 37 == CURLE_FILE_COULDNT_READ_FILE, the first failure; the transfer
# running is stopped with 42 == CURLE_ABORTED_BY_CALLBACK
<verify>
<errorcode>
37
</errorcode>
<stdout>
0 37
1 42
</stdout>
<stderr mode="text">
curl: (37) Could not open file %FILE_PWD/%LOGDIR/nosuch%TESTNUMBER
curl: (42) Transfer aborted due to critical error in another transfer
</stderr>
</verify>
</testcase>

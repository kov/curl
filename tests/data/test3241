<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HSTS
</keywords>
</info>

# Client-side
<client>
<name>
HSTS cache file with a line one byte too long for the line buffer
</name>
<features>
HSTS
</features>
# The second line is 4095 bytes with its newline: with the zero ending
# it, one more than MAX_HSTS_LINE holds.
<file name="%LOGDIR/hsts%TESTNUMBER">
one.example "20991231 10:00:00"
#%repeat[4093 x x]%
three.example "20991231 10:00:00"
</file>
<command>
http://invalid.invalid/%TESTNUMBER --hsts %LOGDIR/hsts%TESTNUMBER
</command>
</client>

<verify>
# 100 = CURLE_TOO_LARGE
<errorcode>
100
</errorcode>
<file name="%LOGDIR/hsts%TESTNUMBER" mode="text">
# Your HSTS cache. https://curl.se/docs/hsts.html
# This file was generated by libcurl! Edit at your own risk.
one.example "20991231 10:00:00"
</file>
</verify>
</testcase>

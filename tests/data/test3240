<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTPS
HTTP GET
</keywords>
</info>

# Client-side
<client>
<features>
SSL
</features>
<server>
https
</server>
<name>
HTTPS with the native CA store and a CA file that does not load
</name>
# Where the system's store loads first (Windows), the file is passed over
# and the peer, whose CA the system does not trust, fails verification:
# what loading the file queued is not the handshake's error. Where nothing
# loads first, the file's failure is the transfer's.
<command>
https://%HOSTIP:%HTTPSPORT/want/%TESTNUMBER --ca-native --cacert "%LOGDIR/cacert"
</command>
<file name="%LOGDIR/cacert">
made up content
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
60,77
</errorcode>
</verify>
</testcase>

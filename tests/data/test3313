<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP proxy
connect to non-listen
progress
</keywords>
</info>
# Server-side
<reply>
</reply>

# Client-side
<client>
<features>
http
proxy
</features>
<name>
no progress meter for a proxy refusing the connect
</name>

# the meter is on: it shows only once the transfer has connected
<command>
-x %HOSTIP:%NOLISTENPORT http://example.invalid/%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<errorcode>
7
</errorcode>
<file name="%LOGDIR/stderr%TESTNUMBER" mode="text">
curl: (7) Failed to connect to %HOSTIP:%NOLISTENPORT over proxy %HOSTIP after X ms: Could not connect to server
</file>
<stripfile>
s/after \d+ ms/after X ms/
</stripfile>
</verify>
</testcase>

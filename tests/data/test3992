<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SFTP
HTTPS proxy
</keywords>
</info>

# Server-side
<reply>
<connect crlf="headers">
HTTP/1.1 200 OK
Date: Tue, 09 Nov 2010 14:49:00 GMT
Server: test-server/fake
Content-Length: 0

</connect>
</reply>

# Client-side
<client>
<server>
sftp
https-proxy
</server>
<features>
libssh2
proxy
</features>
<name>
SFTP retrieval through an HTTPS proxy
</name>
<command>
--key %LOGDIR/server/curl_client_key --pubkey %LOGDIR/server/curl_client_key.pub -u %USER: -p -x https://%HOSTIP:%HTTPSPROXYPORT --proxy-insecure sftp://%HOSTIP:%SSHPORT%SFTP_PWD/%LOGDIR/file%TESTNUMBER.txt --insecure
</command>
<file name="%LOGDIR/file%TESTNUMBER.txt">
Through the proxy's TLS, the SSH bytes went.
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout>
Through the proxy's TLS, the SSH bytes went.
</stdout>
<proxy crlf="headers">
CONNECT %HOSTIP:%SSHPORT HTTP/1.1
Host: %HOSTIP:%SSHPORT
User-Agent: curl/%VERSION
Proxy-Connection: Keep-Alive

</proxy>
</verify>
</testcase>

<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
--speed-time
timeout
</keywords>
</info>

# Server-side
<reply>
<data nocheck="yes">
HTTP/1.1 200 OK
Content-Length: 6

-foo-
</data>
<servercmd>
idle
</servercmd>
</reply>

# Client-side
<client>
<server>
http
</server>
<name>
--speed-time alone fails a transfer slower than a byte a second
</name>
<command>
http://%HOSTIP:%HTTPPORT/%TESTNUMBER --speed-time 1 -m 10 -sS
</command>
</client>

# Verify data after the test has been "shot"
# The server sends nothing: the low speed check fails the transfer after
# a second, well before the overall timeout.
<verify>
<errorcode>
28
</errorcode>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:%HTTPPORT
User-Agent: curl/%VERSION
Accept: */*

</protocol>
<stderr mode="text">
curl: (28) Operation too slow. Less than 1 bytes/sec transferred the last 1 seconds
</stderr>
</verify>
</testcase>

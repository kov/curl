<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
SFTP
post-quote
</keywords>
</info>

# Server-side
<reply>
</reply>

# Client-side
<client>
<server>
sftp
</server>
<features>
libssh
</features>
<name>
SFTP post-quote pwd, the path of the transfer already gone
</name>
<command>
--key %LOGDIR/server/curl_client_key --pubkey %LOGDIR/server/curl_client_key.pub -u %USER: -D %LOGDIR/heads%TESTNUMBER -Q "-pwd" sftp://%HOSTIP:%SSHPORT%SFTP_PWD/%LOGDIR/file%TESTNUMBER.txt --insecure
</command>
<file name="%LOGDIR/file%TESTNUMBER.txt">
the body
</file>
</client>

# Verify data after the test has been "shot"
<verify>
<stdout>
the body
</stdout>
<file name="%LOGDIR/heads%TESTNUMBER">
257 "(nil)" is current directory.
</file>
</verify>
</testcase>

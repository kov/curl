<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
FTP
HTTP
HTTP GET
HTTP proxy
followlocation
</keywords>
</info>

# Server-side
<reply>
<data>
HTTP/1.1 302 Moved
Location: ftp://ftp.%TESTNUMBER/%TESTNUMBER0002
Content-Length: 0

</data>
<data2>
HTTP/1.1 200 OK
Content-Length: 6

hello
</data2>
<datacheck>
HTTP/1.1 302 Moved
Location: ftp://ftp.%TESTNUMBER/%TESTNUMBER0002
Content-Length: 0

HTTP/1.1 200 OK
Content-Length: 6

hello
</datacheck>
</reply>

# Client-side
<client>
<server>
http
</server>
<features>
ftp
proxy
</features>
<name>
FTP over HTTP proxy after HTTP on its port sends no credentials
</name>
<command>
http://ftp.%TESTNUMBER:21/%TESTNUMBER -x %HOSTIP:%HTTPPORT -u user:secret -H "Cookie: crumb=1" -L
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET http://ftp.%TESTNUMBER:21/%TESTNUMBER HTTP/1.1
Host: ftp.%TESTNUMBER:21
Authorization: Basic dXNlcjpzZWNyZXQ=
User-Agent: curl/%VERSION
Accept: */*
Proxy-Connection: Keep-Alive
Cookie: crumb=1

GET ftp://ftp.%TESTNUMBER/%TESTNUMBER0002 HTTP/1.1
Host: ftp.%TESTNUMBER:21
User-Agent: curl/%VERSION
Accept: */*
Proxy-Connection: Keep-Alive

</protocol>
</verify>
</testcase>

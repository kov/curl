<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
Alt-Svc
</keywords>
</info>

# Client-side
<client>
<name>
alt-svc cache file ending in a line too long once its newline is added
</name>
<features>
alt-svc
</features>
# The last line is 4094 bytes and has no newline: with the one added and
# the zero ending it, one more than MAX_ALTSVC_LINE holds.
<file name="%LOGDIR/altsvc%TESTNUMBER" nonewline="yes">
h2 one.example 443 h2 one.example 443 "20991231 10:00:00" 0 0
#%repeat[4093 x x]%
</file>
<command>
http://invalid.invalid/%TESTNUMBER --alt-svc %LOGDIR/altsvc%TESTNUMBER
</command>
</client>

<verify>
# 100 = CURLE_TOO_LARGE
<errorcode>
100
</errorcode>
<file name="%LOGDIR/altsvc%TESTNUMBER" mode="text">
# Your alt-svc cache. https://curl.se/docs/alt-svc.html
# This file was generated by libcurl! Edit at your own risk.
h2 one.example 443 h2 one.example 443 "20991231 10:00:00" 0 0
</file>
</verify>
</testcase>

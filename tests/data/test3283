<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
HTTP GET
--trace-config
</keywords>
</info>

# Server-side
<reply>
<data crlf="headers">
HTTP/1.1 200 OK
Content-Length: 6

hello
</data>
</reply>

# Client-side
<client>
<features>
verbose-strings
</features>
<server>
http
</server>
<name>
--trace-config setup,multi traces the connection setup's filter chain
</name>
<command>
-v --trace-config setup,multi http://%HOSTIP:%HTTPPORT/%TESTNUMBER
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<file name="%LOGDIR/stderr%TESTNUMBER" mode="text">
* [SETUP] added
* [MULTI] [CONNECTING] cf_setup_connect [0][!DNS][!SETUP]
* [MULTI] [CONNECTING] cf_setup_connect [0][!DNS][!SETUP][!HAPPY-EYEBALLS]
* [MULTI] [CONNECTING] cf_setup_connect [0][!DNS][!SETUP][!HAPPY-EYEBALLS]
* [MULTI] [CONNECTING] connected [0][DNS][SETUP][HAPPY-EYEBALLS][TCP]
* [SETUP] removing connected setup filter
* [SETUP] destroy
* [MULTI] [CONNECTING] reduced to [0][TCP]
</file>
<stripfile>
$_ = '' if !/^\* \[(?:SETUP\] (?:added\s*$|removing|destroy)|MULTI\] \[CONNECTING\] (?:cf_setup_connect|connected|reduced to))/
</stripfile>
</verify>
</testcase>

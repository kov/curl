<?xml version="1.0" encoding="US-ASCII"?>
<testcase>
<info>
<keywords>
HTTP
SOCKS5
</keywords>
</info>
# Server-side
<reply>
<data crlf="headers">
HTTP/1.1 200 OK
Content-Length: 6
Connection: close

-foo-
</data>
# method 2 is SOCKS5 asking for user+password; the client must offer
# exactly two methods: none and user+password, not GSS-API
<servercmd>
method 2
nmethods_min 2
nmethods_max 2
user uz3r
password p4ssworm
backendport %HTTPPORT
</servercmd>
</reply>

# Client-side
<client>
<server>
socks5
http
</server>
<features>
proxy
</features>
<name>
SOCKS5 proxy auth with --socks5-basic offers no GSS-API
</name>

# target a port that does not work without the SOCKS magic
<command>
http://%HOSTIP:1/%TESTNUMBER -x socks5://uz3r:p4ssworm@%HOSTIP:%SOCKSPORT --socks5-basic
</command>
</client>

# Verify data after the test has been "shot"
<verify>
<protocol crlf="headers">
GET /%TESTNUMBER HTTP/1.1
Host: %HOSTIP:1
User-Agent: curl/%VERSION
Accept: */*

</protocol>
</verify>
</testcase>
